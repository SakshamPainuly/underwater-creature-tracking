# Raw biology dataset is large (~5.5 GB), read-only, and provided out-of-band.
# Never commit it -- only derived/processed outputs under data/processed/ are tracked.
data/raw/

# Generated YOLO dataset view (links + small label files); rebuilt per machine by
# scripts/prepare_yolo_dataset.py, so it is never committed.
data/yolo/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Model weights and videos (large; stored off-repo per CLAUDE.md §5/§8, referenced by path + sha256)
*.pt
*.pth
*.onnx
*.mp4
*.mov
*.avi
*.mkv
# Uppercase variants (GoPro writes .MP4); needed where git matches case-sensitively (Linux/Colab)
*.MP4
*.MOV
*.AVI
*.MKV

# Training/inference run folders (off-repo per CLAUDE.md §5/§8)
runs/

# Notebook autosaves (notebooks are committed without outputs)
.ipynb_checkpoints/

# Credentials and secrets -- never commit
.env
.env.*
.streamlit/secrets.toml
kaggle.json
.netrc
credentials.json
token.json
client_secret*.json
service_account*.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
